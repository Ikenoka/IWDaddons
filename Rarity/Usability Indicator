// ==UserScript==
// @name        Rarity/Usability Indicator
// @namespace   Addons
// @match       https://play.isleward.com/*
// @match       https://ptr.isleward.com/*
// @version     2.0
// @author      Kara + Claude <3
// @description ADds a rarity glow around the item sprite, with an indicator for unequippable itemms in the top right
// @grant       none
// ==/UserScript==
/*
 * Rarity/Usability Indicator — Isleward addon
 *
 * Two indicators on item slots (inventory, equipment, anything rendered via renderItem):
 *   1. Rarity glow: a glow around the item sprite in its rarity colour.
 *   2. Usability marker: a small red square in the slot's top-right corner when the item's
 *      level is above your level, or any of its str/dex/int requirements exceeds your
 *      character's value of that stat.
 * Standalone: no dependency on the other  addons.
 */
(function () {
	// ---- Settings: rarity glow ----------------------------------------------
	// Isleward item.quality: 0 common, 1 magic, 2 rare, 3 epic, 4 legendary.
	// NOTE: these hex values are from memory of Isleward's palette - tweak if a shade looks off.
	const GLOW_ENABLED = true;
	const GLOW_COMMON = false;    // set true to also glow common (white) items
	const COLORS = {
		0: '#fcfcfc',   // common    - white
		1: '#51fc9a',   // magic     - green
		2: '#3fa7dd',   // rare      - blue
		3: '#a24eff',   // epic      - purple
		4: '#ff6942'    // legendary - orange
	};

	// ---- Settings: usability marker -----------------------------------------
	const MARKER_ENABLED = true;
	const MARKER_SIZE_PX = 9;
	const MARKER_COLOR = '#d93845';   // slightly darkened from my recollection of Isleward's red (#ff4252)

	// ---- Selectors (adjust here if the game's DOM changes) ------------------
	const SEL_SLOT = '.renderItem.item';
	// -------------------------------------------------------------------------

	const CSS = `
	${SEL_SLOT}.Quality .icon {
		filter: drop-shadow(0 0 1px var(---q)) drop-shadow(0 0 3px var(---q)) drop-shadow(0 0 5px var(---q));
	}
	${SEL_SLOT}.Unusable {
		position: relative;
	}
	${SEL_SLOT}.Unusable::after {
		content: '';
		position: absolute;
		top: 0;
		right: 0;
		width: ${MARKER_SIZE_PX}px;
		height: ${MARKER_SIZE_PX}px;
		background: ${MARKER_COLOR};
		pointer-events: none;
		z-index: 2;
	}
	`;

	let playerStats = null;   // latest character stats from the game's stats events

	function defer(method) {
		if (window.$ && window.addons) method();
		else setTimeout(() => defer(method), 50);
	}

	function injectCss() {
		if (document.getElementById('RarityUsabilityStyle')) return;
		const style = document.createElement('style');
		style.id = 'RarityUsabilityStyle';
		style.textContent = CSS;
		document.head.appendChild(style);
	}

	// ---- Rarity -------------------------------------------------------------
	function qualityColor(item) {
		if (!GLOW_ENABLED || !item) return null;
		const q = Number(item.quality);
		if (!Number.isFinite(q)) return null;
		if (q === 0 && !GLOW_COMMON) return null;
		return COLORS[q] || null;
	}

	// ---- Usability ----------------------------------------------------------
	// An item is unusable when any of its stat requirements (str / dex / int) exceeds the
	// character's current value of that stat.
	// ASSUMPTION: the requirements live in an array on the item, as entries like
	// { stat: 'str', value: 12 }. Edit getRequirements() if the real shape differs.
	const REQ_STATS = ['str', 'dex', 'int'];

	function getRequirements(item) {
		const arr = item.requires || item.requireStats || item.requirements;
		if (!Array.isArray(arr)) return [];
		const out = [];
		arr.forEach(r => {
			if (!r || typeof r !== 'object') return;
			const stat = r.stat || r.name || r.type;
			const value = Number(r.value !== undefined ? r.value : r.amount);
			if (REQ_STATS.indexOf(stat) !== -1 && Number.isFinite(value)) out.push({ stat, value });
		});
		return out;
	}

	function getCharacterStat(stat) {
		if (playerStats && Number.isFinite(playerStats[stat])) return playerStats[stat];
		const p = window.player;
		if (p && p.stats && Number.isFinite(p.stats[stat])) return p.stats[stat];
		return null;
	}

	function getCharacterLevel() {
		if (playerStats && Number.isFinite(playerStats.level)) return playerStats.level;
		const p = window.player;
		return p && Number.isFinite(p.level) ? p.level : null;
	}

	// Unusable if the item's level is above the character's level, OR any str/dex/int
	// requirement is above the character's value of that stat.
	function isUnusable(item) {
		if (!MARKER_ENABLED || !item) return false;
		const level = getCharacterLevel();
		if (level !== null && Number.isFinite(item.level) && item.level > level) return true;
		return getRequirements(item).some(req => {
			const have = getCharacterStat(req.stat);
			return have !== null && req.value > have;
		});
	}

	// ---- Apply to a slot ----------------------------------------------------
	function applySlot(el, item) {
		if (!el) return;
		const $el = window.$(el);
		const color = qualityColor(item);
		if (color) {
			$el.addClass('Quality');
			el.style.setProperty('---q', color);
		} else {
			$el.removeClass('Quality');
			el.style.removeProperty('---q');
		}
		$el.toggleClass('Unusable', isUnusable(item));
	}

	function clearSlot(el) {
		const $el = window.$(el);
		$el.removeClass('Quality Unusable').removeData('IndItem');
		el.style.removeProperty('---q');
	}

	// Fallback + cleanup: re-apply from each slot's stored item, and clear slots that went
	// empty (the game doesn't emit 'beforeRenderItem' for those).
	function reconcile() {
		window.$(SEL_SLOT).each(function () {
			const $el = window.$(this);
			if (this.classList.contains('empty')) {
				if (this.classList.contains('Quality') || this.classList.contains('Unusable')) clearSlot(this);
				return;
			}
			const item = $el.data('IndItem') || $el.data('item') || $el.find('.icon').data('item');
			if (item && typeof item === 'object') applySlot(this, item);
		});
	}

	function watchSlots() {
		const root = document.querySelector('.ui-container') || document.body;
		let pending = false;
		const obs = new MutationObserver(() => {
			if (pending) return;
			pending = true;
			requestAnimationFrame(() => {
				pending = false;
				reconcile();
			});
		});
		obs.observe(root, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
	}

	// ---- Addon registration -------------------------------------------------
	defer(() => {
		injectCss();
		watchSlots();

		window.addons.register({
			init: function ({ events }) {
				// Emitted by renderItem for every item slot, with { el, item }.
				events.on('beforeRenderItem', this.onBeforeRenderItem.bind(this));
				// Stat changes can make items usable/unusable; re-evaluate every slot.
				events.on('onGetStats', this.onGetStats.bind(this));
			},

			onBeforeRenderItem: function (obj) {
				if (!obj || !obj.el || !obj.item) return;
				const { el, item } = obj;
				el.data('IndItem', item);
				const apply = () => {
					if (el.data('IndItem') !== item) return; // slot re-rendered with another item
					applySlot(el[0], item);
				};
				apply();
				// The slot may be redrawn right after the event; re-apply to be safe.
				setTimeout(apply, 0);
				setTimeout(apply, 150);
			},

			onGetStats: function (stats) {
				if (!stats) return;
				// Stat events can be partial; merge them and re-check slots if str/dex/int changed.
				const prev = playerStats || {};
				const next = Object.assign({}, prev, stats);
				const changed = REQ_STATS.concat('level').some(s => next[s] !== prev[s]);
				playerStats = next;
				if (changed) setTimeout(reconcile, 0);
			}
		});
	});
})();
