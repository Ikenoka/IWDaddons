// ==UserScript==
// @name        Idol Pickup Sound
// @match       https://play.isleward.com/*
// @match       https://ptr.isleward.com/*
// @version     1.2.0
// @author      Kara + Claude <3
// @description Plays a deep boom when an idol or arcane fragment enters your inventory
// @grant       none
// ==/UserScript==

/*
 * Idol Pickup Sound — Isleward addon
 *
 * Plays an alert whenever the number of idols in your inventory goes up
 * (Unstable, Bone, Ascendant, Dragon-Glass, Smoldering, Arcane and Charged Arcane Idols), and
 * Arcane Fragments, which count as idols too.
 *
 * The sound
 *   By default the addon plays the original recording, "AlertSound2". The audio track of the mp4 was
 *   copied out unchanged (AAC, no re-encoding) and is embedded further down this file as base64
 *   text (AUDIO_B64), so there is nothing to download and no file to host. The silent lead-in
 *   before the hit is skipped at playback, so the sound starts the instant a pickup is detected.
 *   If the browser can't decode the embedded audio (or USE_RECORDING is false) the addon falls
 *   back to a synthesized re-creation of the clip, described below. The original recording is property
 *   of Grinding Gear Games.
 *
 * The synthesized fallback
 *   It is generated with the Web Audio API and fitted from a spectral analysis of the clip:
 *   - a sharp onset with a ~60 ms burst of band-limited noise (700 Hz - 3 kHz) for the "thump"
 *   - a dense, very bass-heavy cluster of 25 partials from ~32 Hz to ~660 Hz. The loudest is
 *     ~49 Hz, with the rest sitting on a roughly harmonic series of ~16.5 Hz
 *   - the partials are grouped into six frequency bands; each band has its own measured loudness
 *     curve (the ENVELOPES below). Low bands fade fastest, so the tail gets brighter as it dies
 *   - total length about 1.7 s
 *   Edit the [time, level] points to reshape any band.
 *
 * How pickups are detected
 *   Idols are stackable materials, so picking one up usually raises the quantity of an existing
 *   item rather than adding a new one. The addon listens to the game's 'onGetItems' event and
 *   compares the TOTAL quantity of each idol type against the last total it saw. Only an increase
 *   plays the sound, which means that
 *     - moving or splitting stacks does nothing
 *     - spending or dropping idols does nothing (the total just goes down)
 *   Anything that puts idols into your inventory counts: loot, trades, taking them out of your
 *   stash, crafting results.
 *
 *   It never looks at the inventory window, only at the game's item events, so it behaves the
 *   same with the stock inventory, the iwd-inventory mod, or the window closed. Both inventory
 *   UIs listen to the same 'onGetItems' / 'onDestroyItems' events the addon uses, and both
 *   remove destroyed items from the shared item list themselves.
 *
 *   The sound is skipped for a short grace period after you log in, while the game fills the
 *   inventory in.
 *
 * Browsers block audio until you have interacted with the page; the first click or key press
 * unlocks it.
 */
(function () {
	// ---- Settings -----------------------------------------------------------
	const SOUND_ENABLED = true;
	const USE_RECORDING = true;        // true = play the embedded original clip, false = synthesized version
	const SOUND_VOLUME = 0.6;          // 1.0 = level of the reference clip (peak ~0.33). Keep it under ~2.5
	const BASELINE_GRACE_MS = 2500;    // ignore new items while the inventory is first loading
	// Item names that count as idols: anything ending in "Idol", plus Arcane Fragments.
	// Add other names here, e.g. /\bidol$|^arcane fragment$|^some other item$/i
	const IDOL_PATTERN = /\bidol$|^arcane fragment$/i;
	const OUTPUT_GAIN = 1.14;          // calibration so the synthesized fallback matches the reference clip
	const ONSET_THRESHOLD = 0.01;      // the recording's silent lead-in is skipped up to the first sample above this
	const ONSET_PREROLL = 0.004;       // seconds of lead-in kept before that sample, so the attack isn't clipped

	// ---- Sound design (fitted to the reference clip) -------------------------
	// Times are in seconds after the onset
	const ATTACK = 0.004;              // time to reach the first envelope level
	const TAIL = 1.75;                 // oscillators are stopped after this long
	const ENV_TIMES = [0, 0.01, 0.03, 0.07, 0.12, 0.2, 0.3, 0.45, 0.6, 0.8, 1.0, 1.25, 1.6];

	// Each group: partials as [frequency Hz, relative amplitude] and the band's loudness at ENV_TIMES
	const GROUPS = [
		{ // sub-bass body: the 49 Hz boom
			partials: [[32.4, 0.176], [49.4, 1.382], [66.2, 0.241]],
			env: [0.0385, 0.0458, 0.0638, 0.0816, 0.0861, 0.0876, 0.0707, 0.0507, 0.0277, 0.0123, 0.0064, 0.0023, 0.0005]
		},
		{
			partials: [[80.9, 0.422], [88.5, 0.528], [97.6, 1.242]],
			env: [0.0122, 0.0169, 0.0244, 0.0304, 0.024, 0.0168, 0.0139, 0.0098, 0.0067, 0.0044, 0.0026, 0.0015, 0.001]
		},
		{
			partials: [[120.9, 0.815], [131.5, 0.935], [149.4, 0.446], [160.9, 0.512]],
			env: [0.0274, 0.0409, 0.0478, 0.0384, 0.0236, 0.0151, 0.014, 0.0132, 0.0071, 0.0036, 0.0025, 0.0013, 0.0005]
		},
		{
			partials: [[196.2, 1.035], [214.7, 0.509], [239.7, 0.574], [252.4, 0.584]],
			env: [0.0217, 0.0267, 0.03, 0.0236, 0.015, 0.0116, 0.0096, 0.0077, 0.006, 0.0036, 0.002, 0.0011, 0.0003]
		},
		{
			partials: [[301.2, 0.61], [317.6, 0.249], [325.6, 0.614], [341.5, 0.511], [349.1, 0.484],
				[390.9, 0.465], [407.9, 0.339], [459.4, 0.384], [469.7, 0.285], [509.1, 0.363]],
			env: [0.0287, 0.0383, 0.0467, 0.0371, 0.0223, 0.0169, 0.0161, 0.0136, 0.0088, 0.0054, 0.0033, 0.0016, 0.0006]
		},
		{
			partials: [[662.6, 1.414]],
			env: [0.0174, 0.0217, 0.024, 0.0174, 0.0099, 0.0077, 0.007, 0.0055, 0.0046, 0.0035, 0.0022, 0.0011, 0.0004]
		}
	];

	// Onset noise burst: loudness at NOISE_TIMES, band-passed to NOISE_BAND
	const NOISE_BAND = [700, 3000];
	const NOISE_NORM = 5.13;           // brings the filtered noise to unit RMS before the envelope is applied
	const NOISE_ATTACK = 0.002;
	const NOISE_TIMES = [0, 0.004, 0.01, 0.02, 0.035, 0.05, 0.08, 0.12, 0.2, 0.3, 0.5, 0.8, 1.2];
	const NOISE_ENV = [0.0065, 0.0204, 0.0328, 0.0362, 0.0368, 0.024, 0.0122, 0.0088, 0.0088, 0.0088, 0.0069, 0.0035, 0.0015];

	// ---- State --------------------------------------------------------------
	const FLOOR = 0.0001;              // exponential ramps can't touch zero
	let audioCtx = null;
	let noiseBuffer = null;
	let recording = null;              // { buffer, offset } once the embedded clip has been decoded
	let recordingState = 'idle';       // idle -> decoding -> ready | failed
	let lastTotals = null;             // idol name -> total quantity last time we looked (null = not yet known)
	let baselineTime = 0;

	function defer(method) {
		if (window.$ && window.addons) method();
		else setTimeout(() => defer(method), 50);
	}

	// ---- Audio --------------------------------------------------------------
	function getAudio() {
		if (audioCtx) return audioCtx;
		const Ctx = window.AudioContext || window.webkitAudioContext;
		if (!Ctx) return null;
		try { audioCtx = new Ctx(); } catch (e) { audioCtx = null; }
		return audioCtx;
	}

	// Browsers block audio until the user interacts with the page; warm it up on first input.
	function unlockAudioOnInput() {
		const unlock = () => {
			const ctx = getAudio();
			if (ctx && ctx.state === 'suspended') ctx.resume().catch(() => {});
			prepareRecording();
		};
		['pointerdown', 'keydown'].forEach(ev =>
			window.addEventListener(ev, unlock, { once: true, capture: true })
		);
	}

	// Loudness automation: silence -> first level in ATTACK seconds, then exponential ramps through
	// the remaining points (times[0] is the onset itself, so it is covered by the attack).
	function automate(param, t0, times, levels, attack) {
		param.setValueAtTime(FLOOR, t0);
		param.exponentialRampToValueAtTime(Math.max(levels[0], FLOOR), t0 + attack);
		for (let i = 1; i < times.length; i++)
			param.exponentialRampToValueAtTime(Math.max(levels[i], FLOOR), t0 + times[i]);
	}

	function getNoiseBuffer(ctx) {
		if (noiseBuffer && noiseBuffer.sampleRate === ctx.sampleRate) return noiseBuffer;

		const len = Math.floor(ctx.sampleRate * (NOISE_TIMES[NOISE_TIMES.length - 1] + 0.1));
		noiseBuffer = ctx.createBuffer(1, len, ctx.sampleRate);
		const d = noiseBuffer.getChannelData(0);
		for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;

		return noiseBuffer;
	}

	function playIdolSound(ctx, dest, t0) {
		const out = ctx.createGain();
		out.gain.value = SOUND_VOLUME * OUTPUT_GAIN;
		out.connect(dest);

		// Tonal body: six bands of sine partials, each with its own loudness curve
		for (const group of GROUPS) {
			const g = ctx.createGain();
			automate(g.gain, t0, ENV_TIMES, group.env, ATTACK);
			g.connect(out);

			for (const [freq, amp] of group.partials) {
				const o = ctx.createOscillator();
				const pg = ctx.createGain();
				o.type = 'sine';
				o.frequency.setValueAtTime(freq, t0);
				pg.gain.value = amp;
				o.connect(pg);
				pg.connect(g);
				o.start(t0);
				o.stop(t0 + TAIL);
			}
		}

		// Onset burst: band-limited noise for the initial thump
		const src = ctx.createBufferSource();
		src.buffer = getNoiseBuffer(ctx);

		const hp = ctx.createBiquadFilter();
		hp.type = 'highpass';
		hp.frequency.value = NOISE_BAND[0];
		hp.Q.value = Math.SQRT1_2;

		const lp = ctx.createBiquadFilter();
		lp.type = 'lowpass';
		lp.frequency.value = NOISE_BAND[1];
		lp.Q.value = Math.SQRT1_2;

		const ng = ctx.createGain();
		automate(ng.gain, t0, NOISE_TIMES, NOISE_ENV.map(v => v * NOISE_NORM), NOISE_ATTACK);

		src.connect(hp);
		hp.connect(lp);
		lp.connect(ng);
		ng.connect(out);
		src.start(t0);
		src.stop(t0 + NOISE_TIMES[NOISE_TIMES.length - 1] + 0.05);
	}

	// ---- The embedded recording ---------------------------------------------
	function base64ToArrayBuffer(b64) {
		const bin = atob(b64);
		const bytes = new Uint8Array(bin.length);
		for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
		return bytes.buffer;
	}

	// Seconds of silence at the start of the clip, so playback can begin right at the hit
	function findOnset(buffer) {
		const data = buffer.getChannelData(0);
		for (let i = 0; i < data.length; i++) {
			if (Math.abs(data[i]) > ONSET_THRESHOLD)
				return Math.max(0, i / buffer.sampleRate - ONSET_PREROLL);
		}

		return 0;
	}

	// Decode once, ahead of the first pickup. Safe to call repeatedly.
	function prepareRecording() {
		if (!USE_RECORDING || recordingState !== 'idle') return;

		const ctx = getAudio();
		if (!ctx) return;

		recordingState = 'decoding';

		const done = buffer => {
			recording = { buffer, offset: findOnset(buffer) };
			recordingState = 'ready';
		};
		const failed = () => { recordingState = 'failed'; };

		try {
			// decodeAudioData has both a promise and a callback form depending on the browser's age
			const result = ctx.decodeAudioData(base64ToArrayBuffer(AUDIO_B64), done, failed);
			if (result && typeof result.then === 'function') result.then(done, failed);
		} catch (e) {
			failed();
		}
	}

	function playRecording(ctx, t0) {
		const src = ctx.createBufferSource();
		src.buffer = recording.buffer;

		const gain = ctx.createGain();
		gain.gain.value = SOUND_VOLUME;

		src.connect(gain);
		gain.connect(ctx.destination);
		src.start(t0, recording.offset);
	}

	function playSound() {
		if (!SOUND_ENABLED) return;
		const ctx = getAudio();
		if (!ctx) return;
		if (ctx.state === 'suspended') ctx.resume().catch(() => {});

		const t0 = ctx.currentTime + 0.01;

		if (USE_RECORDING) {
			prepareRecording();

			if (recordingState === 'ready') return playRecording(ctx, t0);
			// Still decoding, or the browser couldn't decode it: use the synthesized version
		}

		playIdolSound(ctx, ctx.destination, t0);
	}

	// ---- Idol tracking ------------------------------------------------------
	// Tolerates decoration other addons or mods may add after the name, e.g. "Bone Idol (x5)" or "Bone Idol [x5]"
	function baseName(name) {
		return name.replace(/\s*[[(].*$/, '').trim();
	}

	function isIdol(item) {
		return !!item && typeof item.name === 'string' && IDOL_PATTERN.test(baseName(item.name));
	}

	// idol name -> total quantity across all stacks in the given item list
	function countIdols(items) {
		const totals = {};
		if (!items || !items.length) return totals;

		for (const item of items) {
			if (!isIdol(item)) continue;
			const qty = Number.isFinite(item.quantity) ? item.quantity : 1;
			const key = baseName(item.name);
			totals[key] = (totals[key] || 0) + qty;
		}

		return totals;
	}

	function hasGained(before, after) {
		return Object.keys(after).some(name => after[name] > (before[name] || 0));
	}

	function currentInventoryItems() {
		const player = window.player;
		return player && player.inventory ? player.inventory.items : null;
	}

	function onGetItems(items) {
		if (!Array.isArray(items)) return;

		const now = Date.now();
		const totals = countIdols(items);

		// First look at this character's inventory: start the grace period and just learn the totals
		if (lastTotals === null) {
			baselineTime = now;
			lastTotals = totals;
			return;
		}

		const previous = lastTotals;
		lastTotals = totals;

		if (now - baselineTime < BASELINE_GRACE_MS) return;

		if (hasGained(previous, totals)) playSound();
	}

	// Items being deleted lower the totals; learn them silently so a later pickup still counts as a gain
	function onDestroyItems(ids, items) {
		// The inventory UIs remove the items from the list after this event, and a stack merge sends
		// the destroy and the grown stack in one message, so wait until both have been applied.
		// Reading the list late (rather than excluding the destroyed ids now) is what keeps a merge
		// from looking like a pickup.
		const list = Array.isArray(items) ? items : currentInventoryItems();

		setTimeout(() => {
			if (list && lastTotals !== null) lastTotals = countIdols(list);
		}, 0);
	}

	// A new character session: relearn the inventory from scratch
	function onGetPlayer() {
		lastTotals = null;
	}

	// ---- Embedded audio -----------------------------------------------------
	// The audio track of AlertSound2.mp4, copied out unchanged (AAC in an MP4 container), base64 encoded
	const AUDIO_B64 = '';

	// ---- Addon registration -------------------------------------------------
	defer(() => {
		unlockAudioOnInput();

		window.addons.register({
			init: function ({ events }) {
				// If we load while already in game, start from what's in the inventory right now
				const items = currentInventoryItems();
				if (items && items.length) {
					lastTotals = countIdols(items);
					baselineTime = 0;
				}

				prepareRecording();

				events.on('onGetItems', onGetItems);
				events.on('onDestroyItems', onDestroyItems);
				events.on('onGetPlayer', onGetPlayer);
			}
		});
	});
})();
