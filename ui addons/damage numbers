// ==UserScript==
// @name        Short & Stacked Damage Numbers
// @match       https://play.isleward.com/*
// @match       https://ptr.isleward.com/*
// @version     1.0.0
// @author      Kara + Claude <3
// @description Shortens floating damage / healing numbers (33111 -> 33.1k) and stacks them so the latest three stay readable
// @grant       none
// ==/UserScript==

/*
 * Short & Stacked Damage Numbers — Isleward addon
 *
 * 1) SHORT NUMBERS
 *     99399333999  ->  99.4b        (k = thousand, m = million, b = billion, t = trillion)
 *     1100233      ->  1.1m
 *     33111        ->  33.1k
 *     113.3        ->  113.3        (anything under 1000 is left to the game, so it stays unchanged)
 *     healing keeps its plus sign: +33111 -> +33.1k
 *
 * 2) STACKING
 *     Every target has one stack for damage (right of the sprite) and one for healing (left).
 *     A new number appears at the top of its stack and pushes the older ones down one line.
 *     The newest three stay fully readable; anything older than that fades out quickly while
 *     piling up on the fourth line.
 *
 * How it works
 *   The game builds the floating text in rendering/numbers.js (module-private) from the
 *   'onGetDamage' event. Two handlers are added to that event:
 *     - one moved to the FRONT of the handler list: rewrites msg so the game draws the short text
 *       (the game centres/positions the sprite by its width, so the text must be short before it is built)
 *     - one at the back: finds the sprite the game just added to the 'effects' layer and moves it into
 *       a small wrapper container. The game keeps moving / fading the sprite itself; the wrapper only
 *       adds a vertical offset (the stack position) and an extra fade for old numbers.
 *   Nothing in the game's own code or data is modified.
 */
(function () {
	// ---- Settings -----------------------------------------------------------
	const DECIMALS = 1;               // digits after the point for shortened numbers
	const DROP_TRAILING_ZERO = false; // true: 1.0m -> 1m
	const UNITS = ['', 'k', 'm', 'b', 't'];

	const VISIBLE_COUNT = 3;          // how many of the latest numbers stay readable
	const LINE_SPACING = 0.9;         // line height as a fraction of the text height
	const SLIDE_SPEED = 0.3;          // 0-1, how quickly numbers slide down to their slot
	const FADE_FRAMES = 12;           // frames an overflow number takes to fade away
	const TTL = 90;                   // frames a number lives (game default 35; longer so 3 can be read)
	const FLOAT_SPEED = 0.4;          // how fast numbers drift upward (game default 1)
	// -------------------------------------------------------------------------

	function defer(method) {
		if (typeof window === 'undefined') return;
		if (window.$ && window.addons) method();
		else setTimeout(() => defer(method), 50);
	}

	// 99399333 -> "99.4m"; numbers under 1000 come back exactly as given
	function shorten(n) {
		if (!isFinite(n) || Math.abs(n) < 1000) return String(n);

		const sign = n < 0 ? '-' : '';
		const scale = Math.pow(10, DECIMALS);
		let value = Math.abs(n);
		let unit = 0;

		while (value >= 1000 && unit < UNITS.length - 1) {
			value /= 1000;
			unit++;
		}

		let rounded = Math.round(value * scale) / scale;

		// 999.96k rounds to 1000.0k: move up one unit instead
		if (rounded >= 1000 && unit < UNITS.length - 1) {
			rounded = Math.round((rounded / 1000) * scale) / scale;
			unit++;
		}

		let text = rounded.toFixed(DECIMALS);
		if (DROP_TRAILING_ZERO && DECIMALS > 0) text = text.replace(/\.?0+$/, '');

		return sign + text + UNITS[unit];
	}

	// ---- Stacking -----------------------------------------------------------
	const stacks = new Map();  // "targetId:heal|dmg" -> entries, newest first
	let layer = null;          // the game's 'effects' layer
	let pending = null;        // set by the front handler, consumed by the back handler

	function frontHandler(msg) {
		pending = null;
		if (!msg || msg.event || typeof msg.amount !== 'number') return;

		pending = { key: msg.id + ':' + (msg.heal ? 'heal' : 'dmg'), childCount: layer.children.length };

		if (msg.ttl === undefined) msg.ttl = TTL;
		if (msg.movementDelta === undefined) msg.movementDelta = [0, -FLOAT_SPEED];

		// Game's getText() uses msg.text whenever msg.amount is undefined
		if (Math.abs(msg.amount) >= 1000) {
			msg.text = (msg.heal ? '+' : '') + shorten(msg.amount);
			delete msg.amount;
		}
	}

	function backHandler() {
		const info = pending;
		pending = null;
		if (!info) return;

		// The game skips the number (damage numbers off, target not visible): nothing was added
		if (layer.children.length <= info.childCount) return;

		const sprite = layer.children[layer.children.length - 1];
		const wrapper = new layer.constructor();
		layer.addChild(wrapper);
		wrapper.addChild(sprite);  // the game keeps positioning the sprite inside the wrapper

		let stack = stacks.get(info.key);
		if (!stack) stacks.set(info.key, stack = []);
		stack.unshift({ wrapper, sprite, fade: 1 });
	}

	function removeEntry(entry) {
		if (entry.wrapper.parent) entry.wrapper.parent.removeChild(entry.wrapper);
		entry.wrapper.destroy();
	}

	function frame() {
		stacks.forEach((stack, key) => {
			// The game removes the sprite from the wrapper when its life runs out
			for (let i = stack.length - 1; i >= 0; i--) {
				if (stack[i].sprite.parent === stack[i].wrapper) continue;

				removeEntry(stack[i]);
				stack.splice(i, 1);
			}

			if (!stack.length) {
				stacks.delete(key);
				return;
			}

			let offset = 0;
			stack.forEach((entry, rank) => {
				const { wrapper } = entry;

				wrapper.y += (offset - wrapper.y) * SLIDE_SPEED;

				if (rank >= VISIBLE_COUNT) {
					entry.fade = Math.max(0, entry.fade - (1 / FADE_FRAMES));
					wrapper.alpha = entry.fade;
					wrapper.visible = entry.fade > 0;
				}

				// Overflow numbers all pile onto the line after the last readable one
				if (rank < VISIBLE_COUNT) offset += entry.sprite.height * LINE_SPACING;
			});
		});

		requestAnimationFrame(frame);
	}

	// ---- Addon registration -------------------------------------------------
	defer(() => {
		window.addons.register({
			init: function (props) {
				layer = props.rendererLayers.effects;

				// Front: rewrite msg before the game's handler builds the sprite
				const front = props.events.on('onGetDamage', frontHandler);
				const list = props.events.events.onGetDamage;
				list.splice(list.indexOf(front), 1);
				list.unshift(front);

				// Back: runs after the game's handler, so the new sprite exists
				props.events.on('onGetDamage', backHandler);

				requestAnimationFrame(frame);
			}
		});
	});

	// Exposed for testing in a Node/console environment
	if (typeof module !== 'undefined') module.exports = { shorten };
})();
