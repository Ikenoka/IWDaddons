// ==UserScript==
// @name        Short Health & XP Numbers
// @match       https://play.isleward.com/*
// @match       https://ptr.isleward.com/*
// @version     1.2.0
// @author      Kara + Claude <3
// @description Shortens health numbers (HUD + selected target) and xp / mastery numbers (33111 -> 33.1k, 1100233 -> 1.1m)
// @grant       none
// ==/UserScript==

/*
 * Short Health & XP Numbers — Isleward addon
 *
 * The HUD health bar (yours) and the target frame health bar (selected enemy) show "hp/hpMax" as
 * two full integers, and xp shows up in a few more places. This addon rewrites each number to the
 * highest unit that fits, with one decimal:
 *
 *     99399333  ->  99.4m        (k = thousand, m = million, b = billion, t = trillion)
 *     1100233   ->  1.1m
 *     33111     ->  33.1k
 *     113.3     ->  113.3        (anything under 1000 is left untouched)
 *
 *     "33111/48200"  ->  "33.1k/48.2k"
 *
 * What is shortened
 *   - health   the HUD health bar and the target frame health bar ("hp/hpMax")
 *   - xp       the floating "+1234 xp" text when you gain xp  -> "+1.2k xp"
 *              the "Next Level: 51,234 experience" line on the equipment tab -> "51.2k experience"
 *              the HUD xp bar text when it shows numbers, e.g. the mastery bar ("330/66,000" ->
 *                "330/66.0k"); every number of 1000 or more in the text is shortened, whatever
 *                the surrounding words are. The stock level bar only says "level: N" and is left alone
 *              "Next Mastery Level: 1,200 experience" and any other "N experience" line on the equipment tab
 *   Hover tooltips keep the exact numbers.
 *
 * Where the data comes from
 *   The game writes the text itself (hud.js and target.js call .html(hp + '/' + hpMax) on the
 *   first '.statBox .text' of '.uiHud' and '.uiTarget' whenever health changes). We watch those
 *   two elements with a MutationObserver and rewrite the text right after the game does, before
 *   the browser paints. Nothing in the game's own code or data is touched, so the exact values are
 *   still used for the bar width and the HUD hover tooltip (which keeps showing full numbers).
 *
 * Notes
 *   - Mana is left alone.
 *   - The floating xp text is changed by running before the game's own onGetDamage handler (it is
 *     moved to the front of the handler list), because the game turns the text into a sprite
 *     straight away.
 *   - Numbers are rounded, not truncated, and a value that rounds up to the next unit is promoted
 *     (999 950 -> 1.0m, not 1000.0k).
 */
(function () {
	// ---- Settings -----------------------------------------------------------
	const DECIMALS = 1;                // digits after the point for shortened numbers
	const DROP_TRAILING_ZERO = false;  // true: 1.0m -> 1m   false: 1.0m stays 1.0m
	const SHORTEN_HUD = true;          // your own health bar
	const SHORTEN_TARGET = true;       // the selected enemy's health bar
	const SHORTEN_XP = true;           // floating "+N xp", equipment "Next Level" line, HUD xp bar text
	const UNITS = ['', 'k', 'm', 'b', 't'];  // each step is a factor of 1000

	// ---- Selectors (adjust here if the game's DOM changes) ------------------
	const SEL_HUD_TEXT = '.uiHud .statBox .statHp + .text';
	const SEL_TARGET_TEXT = '.uiTarget .statBox .statHp + .text';
	const ANY_NUMBER = /\d[\d,]*(?:\.\d+)?/g;
	const SEL_XP_TEXT = '.uiHud .statBox .statXp + .text';
	const SEL_EQUIPMENT_STAT = '.uiEquipment .stat font';
	// -------------------------------------------------------------------------

	const TEXT_FORMAT = /^\s*(-?\d+(?:\.\d+)?)\s*\/\s*(-?\d+(?:\.\d+)?)\s*$/;
	const XP_GAIN_FORMAT = /^(\+\s*)(\d+(?:\.\d+)?)(\s*xp)$/i;                    // "+1234 xp"
	const NEXT_LEVEL_FORMAT = /^(\d{1,3}(?:,\d{3})*(?:\.\d+)?|\d+(?:\.\d+)?)(\s+experience)$/;  // "51,234 experience"

	function defer(method) {
		if (window.$ && window.addons) method();
		else setTimeout(() => defer(method), 50);
	}

	// 99399333 -> "99.4m"; numbers under 1000 come back exactly as given
	function shorten(n) {
		if (!isFinite(n) || Math.abs(n) < 1000) return String(n);

		const sign = n < 0 ? '-' : '';
		const scale = Math.pow(10, DECIMALS);
		let value = Math.abs(n);
		let unit = 0;

		while (value >= 1000 && unit < UNITS.length - 1) {
			value /= 1000;
			unit++;
		}

		let rounded = Math.round(value * scale) / scale;

		// 999.96k rounds to 1000.0k: move up one unit instead
		if (rounded >= 1000 && unit < UNITS.length - 1) {
			rounded = Math.round((rounded / 1000) * scale) / scale;
			unit++;
		}

		let text = rounded.toFixed(DECIMALS);
		if (DROP_TRAILING_ZERO && DECIMALS > 0) text = text.replace(/\.?0+$/, '');

		return sign + text + UNITS[unit];
	}

	// "33111/48200" -> "33.1k/48.2k"; anything that isn't "number/number" (already shortened, empty) -> null
	function rewrite(text) {
		const match = TEXT_FORMAT.exec(text);
		if (!match) return null;

		const result = shorten(Number(match[1])) + '/' + shorten(Number(match[2]));

		return result === text ? null : result;
	}

	function apply(el) {
		const next = rewrite(el.textContent);
		if (next !== null) el.textContent = next;
	}

	// Every number in the text, with or without thousands separators: "330/66,000" -> "330/66.0k"
	function applyXpBar(el) {
		const text = el.textContent;
		const next = text.replace(ANY_NUMBER, token => {
			const value = Number(token.replace(/,/g, ''));

			return isFinite(value) && value >= 1000 ? shorten(value) : token;
		});

		if (next !== text) el.textContent = next;
	}

	// "51,234 experience" -> "51.2k experience" (the game writes the number with thousands separators)
	function applyNextLevel(el) {
		const match = NEXT_LEVEL_FORMAT.exec(el.textContent.trim());
		if (!match) return;

		const next = shorten(Number(match[1].replace(/,/g, ''))) + match[2];
		if (next !== el.textContent) el.textContent = next;
	}

	// Floating text event ({ event: true, text: '+1234 xp' }); changes the message before it is drawn
	function onGetDamage(msg) {
		if (!msg || !msg.event || typeof msg.text !== 'string') return;

		const match = XP_GAIN_FORMAT.exec(msg.text);
		if (match) msg.text = match[1] + shorten(Number(match[2])) + match[3];
	}

	function hudSelectors() {
		const list = [];
		if (SHORTEN_HUD) list.push(SEL_HUD_TEXT);
		if (SHORTEN_TARGET) list.push(SEL_TARGET_TEXT);

		return list.join(',');
	}

	function start() {
		const selector = hudSelectors();
		if (!selector && !SHORTEN_XP) return;
		const xpSelector = SHORTEN_XP ? SEL_XP_TEXT : null;

		// Our own rewrite also triggers the observer; it is ignored because "33.1k/48.2k" no longer
		// matches the "number/number" format
		const observer = new MutationObserver(mutations => {
			const done = new Set();

			for (const m of mutations) {
				// The game replaces the text with .html(), so the mutation target is the '.text' element
				// itself (childList) or its text node (characterData)
				const el = m.target.nodeType === 1 ? m.target : m.target.parentElement;
				if (!el) continue;

				if (selector && !done.has(el) && el.matches(selector)) {
					done.add(el);
					apply(el);
				}

				if (xpSelector && !done.has(el) && el.matches(xpSelector)) {
					done.add(el);
					applyXpBar(el);
				}

				// The equipment tab rebuilds its stat rows, so look inside whatever was added
				if (SHORTEN_XP) {
					m.addedNodes.forEach(node => {
						if (node.nodeType !== 1) return;

						if (node.matches(SEL_EQUIPMENT_STAT)) applyNextLevel(node);
						node.querySelectorAll(SEL_EQUIPMENT_STAT).forEach(applyNextLevel);
					});
				}
			}
		});

		observer.observe(document.body, { childList: true, characterData: true, subtree: true });

		// Catch anything already on screen when we start
		if (selector) document.querySelectorAll(selector).forEach(apply);
		if (xpSelector) document.querySelectorAll(xpSelector).forEach(applyXpBar);
		if (SHORTEN_XP) document.querySelectorAll(SEL_EQUIPMENT_STAT).forEach(applyNextLevel);
	}

	// ---- Addon registration -------------------------------------------------
	defer(() => {
		window.addons.register({
			init: function (props) {
				if (SHORTEN_XP) {
					// The game's own handler draws the text immediately, so ours has to run first
					const handler = props.events.on('onGetDamage', onGetDamage);
					const list = props.events.events.onGetDamage;
					list.splice(list.indexOf(handler), 1);
					list.unshift(handler);
				}

				if (document.body) start();
				else document.addEventListener('DOMContentLoaded', start);
			}
		});
	});

	// Exposed for testing in a Node/console environment
	if (typeof module !== 'undefined') module.exports = { shorten, rewrite };
})();
